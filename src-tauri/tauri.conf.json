{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eroge Playtime Tracker",
  "version": "0.1.17",
  "identifier": "dev.eroge-playtime-tracker.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run licenses && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Eroge Playtime Tracker",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": { "enable": true, "scope": ["$LOCALDATA/**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_LICENSES.txt": "THIRD_PARTY_LICENSES.txt"
    },
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true } },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYxNERGMkMxM0JGQ0M2NQpSV1Jsekw4VExOOFVENXlUUDRmSlkwNzN0VktESXJXc1dnWWgrS3RHcmpMc0Vjclk5enFQT2pxcgo=",
      "endpoints": [
        "https://github.com/tinypark2010/ErogePlaytimeTracker/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
